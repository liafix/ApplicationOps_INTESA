{
  "name": "applicationops-candidate-demo",
  "version": "0.16.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/seed.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "test:unit": "vitest run tests/unit",
    "test:integration:db": "vitest run tests/integration/applicationops.db.test.ts",
    "backend:mvp:gate": "npm run prisma:validate && npm run prisma:migrate:deploy && npm run test:integration:db",
    "pass7:gate": "python3 scripts/pass7_guided_interaction_gate.py",
    "pass8:gate": "python3 scripts/pass8_release_evidence_gate.py",
    "pass9:gate": "python3 scripts/pass9_diagnostic_correlation_gate.py",
    "pass10:gate": "python3 scripts/pass10_remediation_decision_gate.py",
    "pass11:gate": "python3 scripts/pass11_rollback_recovery_gate.py",
    "pass12:gate": "python3 scripts/pass12_recovery_validation_gate.py",
    "pass13:gate": "python3 scripts/pass13_resolution_handoff_gate.py",
    "pass14:gate": "python3 scripts/pass14_presentation_mode_gate.py",
    "test:all": "vitest run",
    "ci:quality": "npm run format:check && npm run prisma:generate && npm run prisma:validate && npm run lint && npm run typecheck && npm run test && npm run build && npm run security:audit",
    "ci:db": "npm run prisma:generate && npm run prisma:validate && npm run prisma:migrate:deploy && npm run test:integration:db",
    "pass15:gate": "python3 scripts/pass15_ci_repository_gate.py",
    "lock:check": "node scripts/check-lockfile.mjs",
    "pass15:finalize:linux": "bash scripts/pass15_finalize_linux.sh",
    "pass15:finalize:windows": "powershell -ExecutionPolicy Bypass -File scripts/pass15_finalize_windows.ps1",
    "demo:test": "node --test tests/recruiter-demo/state.test.mjs",
    "demo:validate": "node scripts/validate-recruiter-demo.mjs",
    "demo:build": "node scripts/build-recruiter-demo.mjs",
    "demo:verify": "npm run demo:test && npm run demo:validate && npm run demo:build"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "27.2.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prisma": "6.12.0",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.20.6"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "description": "Independent synthetic release and incident support candidate demonstrator.",
  "packageManager": "npm@10.9.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
